MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-address@gmail.com
MAIL_PASSWORD=your-gmail-app-password
# DEV ONLY: print OTP emails in the console when SMTP is not available. Use false in production.
MAIL_LOG_ON_FAILURE=false
# At least 32 characters. Generate one:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-32-or-more-chars
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000
